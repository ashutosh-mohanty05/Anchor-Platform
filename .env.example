# MongoDB Atlas connection string (never commit real values)
MONGODB_URI=

# --- Push notifications (mobile-style alerts for new bookings & reminders) ---
# Generate a key pair once with: npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_...);
# keep the private key secret, server-side only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# A random secret string. Set the same value here and in the cron job that
# calls /api/reminders/due, so random visitors can't trigger it themselves.
CRON_SECRET=

# --- Google Calendar sync (confirmed events are pushed to your Google Calendar) ---
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console, enable the "Google Calendar API" for the project, and add
# <your-domain>/api/integrations/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/api/integrations/google/callback

# --- Voice assistant (optional: enables real conversational AI) ---
# Without this, the voice/text assistant falls back to a smaller set of
# fixed offline commands. With it, she can chat naturally -- ask about
# confirmed events, pending payments, etc. -- not just fixed phrases.
ANTHROPIC_API_KEY=
